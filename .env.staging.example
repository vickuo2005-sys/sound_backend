APP_ENV=staging
LOG_LEVEL=INFO
POSTGRES_SCHEMA_AUTO_INIT=false

NODE_WEBSOCKET_ENABLED=true
COMMAND_WEBSOCKET_ENABLED=true
COMMAND_REST_FALLBACK_ENABLED=true

LIVE_AUDIO_ENABLED=false
LIVE_AUDIO_ALLOWED_CODECS=pcm_s16le
LIVE_AUDIO_DEFAULT_CODEC=pcm_s16le
LIVE_AUDIO_MAX_CONCURRENT_STREAMS=1
LIVE_AUDIO_MAX_SESSION_SECONDS=300
LIVE_AUDIO_RING_BUFFER_SECONDS=10

EVENT_UPLOAD_RETRY_ENABLED=true
FAST_EVENT_INGEST_ENABLED=true
POST_INFERENCE_LATENCY_TRACING_ENABLED=true
DASHBOARD_EVENT_ORDER_GUARD_ENABLED=true
STAGING_DB_LATENCY_PROBE_ENABLED=false
CLASSIFICATION_V1_ENABLED=false
CLASSIFICATION_V1_PERSISTENCE_ENABLED=false
CLASSIFICATION_V1_WEBSOCKET_ENABLED=false
MOTION_SHADOW_ENABLED=false
MOTION_OUTLIER_SPEED_GUARD_ENABLED=false
MOTION_MAX_DIAGNOSTIC_SPEED_MPS=200
TRACKING_ENABLED=true
TRACKING_REORDER_BUFFER_ENABLED=false
TRACKING_REORDER_WINDOW_MS=500
OBSERVATION_SHADOW_ENABLED=true
OBSERVATION_TRACKING_ENABLED=true
OBSERVATION_SHADOW_MAX_RECORDS=10000
OBSERVATION_SEQUENCE_MAX_LATE_MS=2000
OBSERVATION_MISSING_SEQUENCE_TIMEOUT_MS=2000
OBSERVATION_SHADOW_TTL_SECONDS=3600
OBSERVATION_SHADOW_MAX_STREAMS=2048
OBSERVATION_MAX_PENDING_PER_KEY=1024
OBSERVATION_MAX_TRACKS=2048
OBSERVATION_MAILBOX_WORKERS=4
OBSERVATION_FUSION_LATE_ATTACH_MS=2000
OBSERVATION_LIVE_MAX_AGE_MS=5000
OBSERVATION_LIVE_TRACKING_MAX_AGE_MS=120000
OBSERVATION_HISTORICAL_MAX_AGE_MS=21600000
OBSERVATION_IDEMPOTENCY_TTL_SECONDS=21600
OBSERVATION_IDEMPOTENCY_MAX_IDS=50000

DATABASE_URL=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_MAPS_API_KEY=
UPLOAD_TOKEN=
DASHBOARD_WRITE_TOKEN_REQUIRED=true
